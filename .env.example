# ============================================================================
# STI backend - variables de entorno. Copie a `.env` (desarrollo) o configure en Render (producción).
# ============================================================================

# --- Aplicación -------------------------------------------------------------
APP_ENV=production                 # development | test | production
DEBUG=false
FRONTEND_URL=https://sti-frontend-3wf.pages.dev # base de los enlaces de correo (activación, recuperación) y de SSO
PUBLIC_API_URL=https://sti-backend-0g1g.onrender.com
ACTIVATION_PATH=/activar            # ruta del frontend para activar cuenta (?token=...)
RESET_PATH=/restablecer             # ruta del frontend para restablecer contraseña (?token=...)

# --- Base de datos ----------------------------------------------------------
# Desarrollo: SQLite (por defecto ./sti_dev.db). Producción: PostgreSQL 16 (Render entrega postgres://, se normaliza solo).
DATABASE_URL=sqlite:///./sti_dev.db
# DATABASE_URL=postgresql+psycopg://usuario:clave@host:5432/sti
DB_ECHO=false

# --- Seguridad (OBLIGATORIAS en producción; en desarrollo se generan y guardan en .dev_secrets.json) ---
# JWT_SECRET: python -c "import secrets;print(secrets.token_urlsafe(64))"
JWT_SECRET=
# DATA_ENCRYPTION_KEY (AES-256, base64 de 32 bytes): python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# ¡Si se pierde, los datos cifrados (AQ-10, F1, notas F10, diagnóstico) NO se pueden recuperar! Haga copia segura.
DATA_ENCRYPTION_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=480            # 8 h
REFRESH_TOKEN_DAYS=14
REFRESH_COOKIE_NAME=sti_refresh
COOKIE_SECURE=false                 # true en producción (HTTPS)
COOKIE_SAMESITE=lax                 # lax | strict | none  (none exige COOKIE_SECURE=true)
COOKIE_DOMAIN=
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
ACTIVATION_TOKEN_HOURS=72
RESET_TOKEN_HOURS=2
MIN_PASSWORD_LENGTH=10
LOGIN_RATE_LIMIT_PER_MINUTE=20      # por IP; 0 = desactivado
HSTS_ENABLED=                       # vacío = automático (activo en producción o con COOKIE_SECURE=true)

# --- CORS -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173   # separados por coma

# --- Alcance de Bienestar: all (todos los estudiantes del piloto) | assigned (solo asignados) ---
BIENESTAR_SCOPE=all

# --- Correo (SMTP). Sin SMTP_HOST los correos quedan en EMAIL_OUTBOX (estado OMITIDO) y en logs ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=sti@unicordoba.edu.co
SMTP_STARTTLS=true
SMTP_SSL=false

# --- Tareas asíncronas (opcional). Sin broker: en línea / hilo ---
CELERY_BROKER_URL=                  # p. ej. redis://localhost:6379/0
CELERY_RESULT_BACKEND=
JOBS_SECRET=                        # header X-Jobs-Secret del endpoint POST /api/v1/admin/jobs/run-daily (cron externo)

# --- Almacenamiento: Cloudflare R2 (S3). Sin credenciales: disco local ---
STORAGE_DIR=./storage
R2_ENDPOINT_URL=                    # https://<account>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Observabilidad ---
SENTRY_DSN=

# --- IA opcional (GPT-4o vía LangChain). Sin clave/librerías: textos por plantilla determinista ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- SSO institucional OIDC/OAuth2 (opcional; sin configurar -> 501 SSO_NO_CONFIGURADO y login local) ---
SSO_ENABLED=false
SSO_ISSUER=                         # discovery: {issuer}/.well-known/openid-configuration
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=                   # {PUBLIC_API_URL}/api/v1/auth/sso/callback
SSO_SCOPES=openid email profile
SSO_AUTHORIZATION_ENDPOINT=         # alternativa al discovery
SSO_TOKEN_ENDPOINT=
SSO_USERINFO_ENDPOINT=

# --- Semilla y administrador ---
SEED_DEMO=0                         # 1 = crea usuarios demo y 5 estudiantes ficticios (NO en producción)
DEMO_PASSWORD=                      # opcional; por defecto Demo-STI-2026!
ADMIN_EMAIL=                        # para scripts/create_admin.py
ADMIN_PASSWORD=

# --- Registro autónomo SIN correo (prototipo) -------------------------------
REGISTRO_ABIERTO=true               # false cierra el registro libre
STAFF_ACCESS_CODE=                  # código para que Bienestar/Coordinador se registren solos; vacío = solo los crea el admin
EMAIL_ACTIVATION_REQUIRED=false     # true = vuelve a invitaciones por enlace (requiere SMTP)
REGISTRO_RATE_LIMIT_PER_HOUR=30     # por IP; 0 desactiva
